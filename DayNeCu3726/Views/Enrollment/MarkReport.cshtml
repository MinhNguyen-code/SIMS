@model IEnumerable<DayNeCu3726.Models.ViewModels.EnrollmentViewModel>
@{
    ViewData["Title"] = "Academic Mark Report";
    
    // Group courses by semester and order chronologically (Year, then Season: Spring -> Summer -> Fall)
    var grouped = Model.GroupBy(x => x.Schedule)
        .Select(g => {
            var parts = g.Key.Split(' ');
            var season = parts[0];
            var year = parts.Length > 1 && int.TryParse(parts[1], out var y) ? y : 0;
            var rank = season.ToLower() switch {
                "spring" => 1,
                "summer" => 2,
                "fall" => 3,
                _ => 4
            };
            return new { Group = g, Year = year, Rank = rank };
        })
        .OrderBy(x => x.Year)
        .ThenBy(x => x.Rank)
        .Select(x => x.Group);
    
    var completedCredits = Model
        .Where(x => x.Status == DayNeCu3726.Models.Enums.EnrollmentStatus.Completed && x.LetterGrade != "F")
        .Sum(x => x.Credits);
        
    var passCount = Model.Count(x => x.LetterGrade == "P");
    var meritCount = Model.Count(x => x.LetterGrade == "M");
    var distinctionCount = Model.Count(x => x.LetterGrade == "D");
    var failCount = Model.Count(x => x.LetterGrade == "F");
}

<div class="row mb-3 d-print-none">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <div>
            <h1 class="h3 mb-0"><i data-feather="bar-chart-2" class="sims-h-ico"></i> BTEC Mark Report</h1>
            <p class="text-muted mb-0">Official academic transcript & module achievements</p>
        </div>
        <button onclick="window.print()" class="btn btn-primary" style="background-color: var(--sims-navy-700); border-color: var(--sims-navy-700);">
            <i class="align-middle" data-feather="printer"></i> Export / Print Transcript
        </button>
    </div>
</div>

<!-- Print-Only Header -->
<div class="d-none d-print-block mb-4">
    <div class="row align-items-center">
        <div class="col-4">
            <img src="/images/StudentPage/Sidebar/btec.svg" alt="BTEC Logo" style="height: 50px;" />
        </div>
        <div class="col-8 text-end">
            <h3 class="mb-0 fw-bold" style="color: var(--sims-navy-700);">FPT BTEC ALLIANCE</h3>
            <p class="text-muted small mb-0">Official Academic Transcript Report</p>
            <p class="text-muted small mb-0">Student: Nguyen Binh Minh (BH00001)</p>
            <p class="text-muted small mb-0">Date Generated: @DateTime.Today.ToString("dd/MM/yyyy")</p>
        </div>
    </div>
    <hr style="border-top: 2px solid var(--sims-navy-700);" />
</div>

<!-- Summary Widgets -->
<div class="row">
    <div class="col-xl-3 col-sm-6">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col mt-0">
                        <h5 class="card-title">Completed Credits</h5>
                    </div>
                    <div class="col-auto">
                        <div class="stat text-primary">
                            <i class="align-middle" data-feather="award"></i>
                        </div>
                    </div>
                </div>
                <h1 class="mt-1 mb-3">@completedCredits cr</h1>
                <span class="text-muted small">Total credits cleared</span>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-sm-6">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col mt-0">
                        <h5 class="card-title">Distinctions</h5>
                    </div>
                    <div class="col-auto">
                        <div class="stat text-success">
                            <i class="align-middle" data-feather="star"></i>
                        </div>
                    </div>
                </div>
                <h1 class="mt-1 mb-3 text-success">@distinctionCount</h1>
                <span class="text-muted small">Highest module grade (D)</span>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-sm-6">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col mt-0">
                        <h5 class="card-title">Merits</h5>
                    </div>
                    <div class="col-auto">
                        <div class="stat text-primary">
                            <i class="align-middle" data-feather="trending-up"></i>
                        </div>
                    </div>
                </div>
                <h1 class="mt-1 mb-3 text-primary">@meritCount</h1>
                <span class="text-muted small">Medium-high grade (M)</span>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-sm-6">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col mt-0">
                        <h5 class="card-title">Passes / Referrals</h5>
                    </div>
                    <div class="col-auto">
                        <div class="stat text-info">
                            <i class="align-middle" data-feather="check"></i>
                        </div>
                    </div>
                </div>
                <h1 class="mt-1 mb-3 text-info">@passCount <span class="text-muted" style="font-size:18px;">/ @failCount F</span></h1>
                <span class="text-muted small">Satisfactory (P) / Fails (F)</span>
            </div>
        </div>
    </div>
</div>

@functions {
    public static string GetTermLabel(string semester)
    {
        return semester switch {
            "Spring 2025" => "Term 1 (Spring 2025)",
            "Summer 2025" => "Term 2 (Summer 2025)",
            "Fall 2025" => "Term 3 (Fall 2025)",
            "Spring 2026" => "Term 4 (Spring 2026)",
            "Summer 2026" => "Term 5 (Summer 2026)",
            "Fall 2026" => "Term 6 (Fall 2026)",
            _ => semester
        };
    }
}

<!-- Semester Groupings -->
@foreach (var semGroup in grouped)
{
    <div class="row mb-3">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-light">
                    <h5 class="card-title mb-0 text-primary"><i data-feather="calendar" class="sims-h-ico"></i> @GetTermLabel(semGroup.Key)</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover my-0">
                            <thead>
                                <tr>
                                    <th style="width: 15%;">Module Code</th>
                                    <th style="width: 40%;">Module Name</th>
                                    <th>Credits</th>
                                    <th>Attendance</th>
                                    <th>BTEC Grade</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var e in semGroup)
                            {
                                var gradeClass = e.LetterGrade switch {
                                    "D" => "bg-success",
                                    "M" => "bg-primary",
                                    "P" => "bg-info",
                                    "F" => "bg-danger",
                                    _ => "bg-secondary"
                                };
                                
                                var statusText = e.Status.ToString() switch {
                                    "Completed" => "Passed",
                                    "Failed" => "Failed",
                                    _ => "Enrolled"
                                };
                                
                                var statusClass = statusText switch {
                                    "Passed" => "bg-success-light text-success",
                                    "Failed" => "bg-danger-light text-danger",
                                    _ => "bg-primary-light text-primary"
                                };
                                
                                var attendanceOk = e.Absences <= 6;
                                var attendanceColor = attendanceOk ? "text-success" : "text-danger fw-bold";
                                
                                <tr>
                                    <td><strong>@e.CourseCode</strong></td>
                                    <td>@e.CourseName</td>
                                    <td><span class="badge bg-light text-dark">@e.Credits credits</span></td>
                                    <td>
                                        <a href="/Enrollment/Attendance?enrollmentId=@e.EnrollmentId" class="@attendanceColor" title="Click to view detail sheet">
                                            @e.Absences / @e.TotalSessions
                                            <i class="align-middle ms-1" data-feather="eye" style="width:12px;height:12px;"></i>
                                        </a>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(e.LetterGrade))
                                        {
                                            <span class="badge @gradeClass p-2" style="min-width: 32px;">@e.LetterGrade</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Not Evaluated</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge @statusClass">@statusText</span>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<style>
.bg-success-light {
    background-color: rgba(40, 167, 69, 0.15) !important;
}
.bg-danger-light {
    background-color: rgba(220, 53, 69, 0.15) !important;
}
.bg-primary-light {
    background-color: rgba(59, 125, 221, 0.15) !important;
}

/* Print-Specific Styling */
@@media print {
    .sidebar, .navbar, .footer, .btn, .breadcrumb, header, .d-print-none {
        display: none !important;
    }
    .wrapper, .main, .content {
        padding: 0 !important;
        margin: 0 !important;
        background: #white !important;
    }
    .card {
        border: 1px solid #dee2e6 !important;
        box-shadow: none !important;
        margin-bottom: 20px !important;
    }
    body {
        background-color: #fff !important;
        color: #000 !important;
    }
    .card, table, tr {
        page-break-inside: avoid;
    }
}
</style>

<!-- Print-Only Footer -->
<div class="d-none d-print-block mt-5 pt-4">
    <div class="row">
        <div class="col-6">
            <p class="small text-muted">Student Signature</p>
            <br /><br /><br />
            <p class="fw-bold mb-0">Nguyen Binh Minh</p>
            <p class="text-xs text-muted">Date: @DateTime.Today.ToString("dd/MM/yyyy")</p>
        </div>
        <div class="col-6 text-end">
            <p class="small text-muted">Director of Academic Affairs Signature</p>
            <br /><br /><br />
            <p class="fw-bold mb-0">FPT BTEC Board of Directors</p>
            <p class="text-xs text-muted">Official Seal Office</p>
        </div>
    </div>
</div>
