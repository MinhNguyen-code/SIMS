@model IEnumerable<DayNeCu3726.Models.ViewModels.EnrollmentViewModel>
@{
    ViewData["Title"] = "Weekly Timetable";

    // 1. Get selected Year (default to 2026, which is student's active semester year)
    int selectedYear = 2026;
    if (int.TryParse(Context.Request.Query["year"], out var yr))
    {
        selectedYear = yr;
    }

    // Helper: Get first Monday of the year
    DateTime GetFirstMondayOfYear(int year)
    {
        DateTime jan1 = new DateTime(year, 1, 1);
        int daysOffset = ((int)DayOfWeek.Monday - (int)jan1.DayOfWeek + 7) % 7;
        return jan1.AddDays(daysOffset);
    }

    DateTime firstMonday = GetFirstMondayOfYear(selectedYear);

    // 2. Generate 52 weeks of the selected year
    var weeks = new List<(string text, string value, DateTime startDate)>();
    for (int i = 0; i < 52; i++)
    {
        DateTime start = firstMonday.AddDays(i * 7);
        DateTime end = start.AddDays(6);
        string text = $"{start.ToString("dd/MM")} To {end.ToString("dd/MM")}";
        string val = start.ToString("yyyy-MM-dd");
        weeks.Add((text, val, start));
    }

    // 3. Find the selected week
    var selectedWeekVal = Context.Request.Query["week"].ToString();
    DateTime selectedWeekStart;
    
    if (!string.IsNullOrEmpty(selectedWeekVal) && DateTime.TryParse(selectedWeekVal, out var parsedDate))
    {
        selectedWeekStart = parsedDate;
    }
    else
    {
        DateTime today = DateTime.Today;
        if (today.Year == selectedYear)
        {
            // Default to today's week if we are looking at the current year
            int daysOffset = ((int)today.DayOfWeek - (int)DayOfWeek.Monday + 7) % 7;
            selectedWeekStart = today.AddDays(-daysOffset);
        }
        else
        {
            // Smart default week for other years: find semesters in that year that have courses
            var activeSemestersInYear = Model
                .Select(x => x.Schedule) // Holds Semester
                .Where(s => !string.IsNullOrEmpty(s) && s.EndsWith(selectedYear.ToString()))
                .Distinct()
                .ToList();

            if (activeSemestersInYear.Any())
            {
                // Pick the first active semester of the year
                var firstSem = activeSemestersInYear.First();
                if (firstSem.StartsWith("Spring"))
                {
                    // Default to 7th week of the year (mid-February, e.g. Feb 16)
                    selectedWeekStart = firstMonday.AddDays(6 * 7); // week 7
                }
                else if (firstSem.StartsWith("Summer"))
                {
                    // Default to 25th week of the year (mid-June)
                    selectedWeekStart = firstMonday.AddDays(24 * 7);
                }
                else // Fall
                {
                    // Default to 40th week of the year (mid-October)
                    selectedWeekStart = firstMonday.AddDays(39 * 7);
                }
            }
            else
            {
                selectedWeekStart = firstMonday;
            }
        }
    }

    // Adjust selectedWeekVal to match exact generated week value
    var matchingWeek = weeks.FirstOrDefault(w => Math.Abs((w.startDate - selectedWeekStart).TotalDays) < 3);
    if (matchingWeek.value != null)
    {
        selectedWeekStart = matchingWeek.startDate;
        selectedWeekVal = matchingWeek.value;
    }
    else
    {
        selectedWeekVal = weeks.FirstOrDefault().value;
        selectedWeekStart = firstMonday;
    }

    // 4. Calculate day dates of the selected week (Monday to Sunday)
    var dayHeaders = new string[7];
    var dateHeaders = new string[7];
    var daysOfWeek = new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" };
    
    for (int i = 0; i < 7; i++)
    {
        dayHeaders[i] = daysOfWeek[i];
        dateHeaders[i] = selectedWeekStart.AddDays(i).ToString("dd/MM");
    }

    // 5. Determine BTEC semester based on selected week's month
    // Spring: Jan - Apr (Months 1-4)
    // Summer: May - Aug (Months 5-8)
    // Fall: Sep - Dec (Months 9-12)
    int targetMonth = selectedWeekStart.Month;
    string semesterSeason = targetMonth switch
    {
        >= 1 and <= 4 => "Spring",
        >= 5 and <= 8 => "Summer",
        _ => "Fall"
    };
    string activeSemester = $"{semesterSeason} {selectedYear}";

    // Filter enrollments for this active semester
    var semesterCourses = Model.Where(x => x.Schedule == activeSemester).ToList();

    // Rows: 7 slots
    // Columns: 7 days of the week (Monday = 0 to Sunday = 6)
    var grid = new DayNeCu3726.Models.ViewModels.EnrollmentViewModel[7, 7];
    
    // Populate grid based on DayPattern and SlotGroup for BTEC double-slots
    foreach (var e in semesterCourses.Where(x => x.Status == DayNeCu3726.Models.Enums.EnrollmentStatus.Enrolled || x.Status == DayNeCu3726.Models.Enums.EnrollmentStatus.Completed))
    {
        if (string.IsNullOrEmpty(e.DayPattern) || e.SlotGroup < 1 || e.SlotGroup > 3) continue;
        
        var days = e.DayPattern.Split('/');
        foreach (var d in days)
        {
            int colIndex = d.Trim().ToLower() switch
            {
                "mon" => 0,
                "tue" => 1,
                "wed" => 2,
                "thu" => 3,
                "fri" => 4,
                "sat" => 5,
                "sun" => 6,
                _ => -1
            };
            
            if (colIndex != -1)
            {
                int baseRow = (e.SlotGroup - 1) * 2;
                grid[baseRow, colIndex] = e;
                grid[baseRow + 1, colIndex] = e;
            }
        }
    }

    // Slots metadata
    var slots = new[]
    {
        new { Name = "Slot 1", Time = "7:15-9:15" },
        new { Name = "Slot 2", Time = "9:25-11:25" },
        new { Name = "Slot 3", Time = "12:00-14:00" },
        new { Name = "Slot 4", Time = "14:10-16:10" },
        new { Name = "Slot 5", Time = "16:20-18:20" },
        new { Name = "Slot 6", Time = "18:30-20:30" },
        new { Name = "Slot 7", Time = "20:30-22:30" }
    };
}

<div class="row mb-3">
    <div class="col-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 text-sm">
                <li class="breadcrumb-item"><a href="/Dashboard" class="text-muted">Home</a></li>
                <li class="breadcrumb-item active text-dark" aria-current="page">Weekly Timetable</li>
            </ol>
        </nav>
        <h1 class="h3 mb-0" style="color: #333; font-weight: 700;"><i data-feather="calendar" class="sims-h-ico"></i> BTEC Weekly Timetable</h1>
    </div>
</div>

<!-- Selectors (Year & Week side-by-side matching BTEC FAP) -->
<div class="row mb-4">
    <div class="col-md-3 col-sm-6 mb-2">
        <label class="small text-muted fw-bold d-block mb-1">Year</label>
        <select class="form-select btec-dropdown-select" id="yearSelect">
            @for (int y = 2023; y <= 2027; y++)
            {
                if (y == selectedYear)
                {
                    <option value="@y" selected>@y</option>
                }
                else
                {
                    <option value="@y">@y</option>
                }
            }
        </select>
    </div>
    <div class="col-md-4 col-sm-6 mb-2">
        <label class="small text-muted fw-bold d-block mb-1">Week</label>
        <select class="form-select btec-dropdown-select" id="weekSelect">
            @foreach (var w in weeks)
            {
                if (w.value == selectedWeekVal)
                {
                    <option value="@w.value" selected>@w.text</option>
                }
                else
                {
                    <option value="@w.value">@w.text</option>
                }
            }
        </select>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-bordered text-center my-0 align-middle btec-timetable-table" style="table-layout: fixed; border-collapse: collapse;">
                        <thead>
                            <tr style="background-color: var(--sims-navy-700); color: white; border-color: var(--sims-navy-700);">
                                <th style="width: 14%; border: 1px solid #dee2e6;" class="py-2 fw-normal"></th>
                                @for (int i = 0; i < 7; i++)
                                {
                                    <th style="width: 12.28%; border: 1px solid var(--sims-navy-700);" class="py-2 fw-normal">@dayHeaders[i]</th>
                                }
                            </tr>
                            <tr style="background-color: var(--sims-navy-700); color: white; border-color: var(--sims-navy-700);">
                                <th style="border: 1px solid #dee2e6;" class="py-2 fw-normal"></th>
                                @for (int i = 0; i < 7; i++)
                                {
                                    <th style="border: 1px solid var(--sims-navy-700);" class="py-2 fw-normal">@dateHeaders[i]</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @for (int row = 0; row < 7; row++)
                            {
                                <tr>
                                    <td class="bg-light text-start py-3 ps-3 fw-bold" style="border: 1px solid #dee2e6; font-size: 13px;">
                                        @slots[row].Name (@slots[row].Time)
                                    </td>
                                    @for (int col = 0; col < 7; col++)
                                    {
                                        var cell = grid[row, col];
                                        <td style="border: 1px solid #dee2e6; height: 95px; font-size: 13px;" class="py-2 px-1 timetable-cell-container">
                                            @if (cell != null)
                                            {
                                                var classroom = cell.Classroom;
                                                var attendanceStatus = "(Attended)";
                                                var statusColor = "text-success";
                                                
                                                if (cell.Absences > 6)
                                                {
                                                    attendanceStatus = "(Absent)";
                                                    statusColor = "text-danger fw-bold";
                                                }

                                                <div class="d-flex flex-column align-items-center justify-content-center">
                                                    <a href="/Enrollment/Attendance?enrollmentId=@cell.EnrollmentId" class="text-primary fw-bold text-decoration-none">@classroom</a>
                                                    <a href="/Enrollment/Attendance?enrollmentId=@cell.EnrollmentId" class="text-primary text-decoration-none small">(@cell.CourseCode (Offline))</a>
                                                    <span class="text-muted text-xs">at @classroom</span>
                                                    <span class="small @statusColor">@attendanceStatus</span>
                                                </div>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mt-3">
    <div class="col-12">
        <div class="card border-0 shadow-sm bg-light">
            <div class="card-body py-2 px-3">
                <h5 class="fw-bold mb-1" style="color: var(--sims-navy-700); font-size: 14px;"><i data-feather="edit-3" class="sims-h-ico"></i> MORE NOTE:</h5>
                <ul class="list-unstyled mb-0 small text-muted">
                    <li>• Current active semester mapped to selected week: <strong class="text-dark">@activeSemester</strong>.</li>
                    <li>• <span class="text-success fw-bold">(Attended)</span>: Nguyen Binh Minh attended this activity.</li>
                    <li>• Click on the class code or course code to view the detailed 30-session attendance sheet.</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<style>
.btec-timetable-table th {
    vertical-align: middle;
}
.timetable-cell-container {
    background-color: #fff;
    transition: background-color 0.2s;
}
.timetable-cell-container:hover {
    background-color: #fafafa;
}
.text-xs {
    font-size: 11px;
}
.text-primary {
    color: #1a73e8 !important;
}
.text-primary:hover {
    text-decoration: underline !important;
}
.btec-dropdown-select {
    border-color: var(--sims-line);
    background-color: #fff;
    color: var(--sims-navy-700);
    font-weight: 700;
}
.btec-dropdown-select:focus {
    border-color: var(--sims-navy-700);
    box-shadow: 0 0 0 0.25rem rgba(20, 59, 107, 0.25);
}
</style>

@section Scripts {
<script>
document.addEventListener("DOMContentLoaded", function() {
    const yearSelect = document.getElementById("yearSelect");
    const weekSelect = document.getElementById("weekSelect");
    
    function updateTimetable() {
        const year = yearSelect.value;
        const week = weekSelect.value;
        window.location.href = `/Enrollment/Timetable?year=${year}&week=${week}`;
    }
    
    if (yearSelect) {
        yearSelect.addEventListener("change", function() {
            // When year changes, redirect but let the backend pick the default week for that year
            window.location.href = `/Enrollment/Timetable?year=${this.value}`;
        });
    }
    
    if (weekSelect) {
        weekSelect.addEventListener("change", updateTimetable);
    }
});
</script>
}
