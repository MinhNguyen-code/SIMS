@model DayNeCu3726.Models.ViewModels.FacultyListViewModel
@{
    ViewData["Title"] = "Faculties List";
    var role = Context.Session.GetString("UserRole") ?? "";
}

<div class="row mb-3">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <div>
            <h1 class="h3 mb-0"><i data-feather="users" class="sims-h-ico"></i> Faculty Directory</h1>
            <p class="text-muted mb-0">Manage university lecturers and professors (@Model.TotalCount total)</p>
        </div>
        <a href="/Faculty/Create" class="btn btn-primary">
            <i class="align-middle" data-feather="user-plus"></i> Add Faculty
        </a>
    </div>
</div>

<!-- Search Bar & Filters -->
<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2">
            <div class="col-md-9">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0">
                        <i data-feather="search" class="text-muted" style="width:16px;height:16px;"></i>
                    </span>
                    <input name="search" value="@Model.SearchQuery" class="form-control border-start-0" 
                           placeholder="Search by name, email, or department..." />
                </div>
            </div>
            <div class="col-md-3 d-grid gap-2 d-md-flex justify-content-md-end">
                <button type="submit" class="btn btn-primary flex-fill">Search</button>
                @if (!string.IsNullOrEmpty(Model.SearchQuery))
                {
                    <a href="/Faculty" class="btn btn-outline-secondary">Clear</a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Faculty List Card -->
<div class="card">
    <div class="card-body p-0">
        @if (!Model.Faculties.Any())
        {
            <div class="text-center py-5">
                <i data-feather="users" style="width:48px;height:48px;" class="text-muted mb-3"></i>
                <p class="text-muted">No faculties found.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover my-0">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Full Name</th>
                            <th>Department</th>
                            <th>Position</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var f in Model.Faculties)
                    {
                        <tr>
                            <td><span class="badge bg-light text-dark">@f.FacultyCode</span></td>
                            <td>
                                <strong>@f.FullName</strong><br/>
                                <small class="text-muted">@f.Email</small>
                            </td>
                            <td>@f.Department</td>
                            <td>@f.Position</td>
                            <td>
                                @if(f.IsActive) { <span class="badge bg-success">Active</span> }
                                else { <span class="badge bg-danger">Inactive</span> }
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    <a href="/Faculty/Details/@f.Id" class="btn btn-sm btn-outline-primary" title="Details">
                                        <i class="align-middle" data-feather="eye" style="width:14px;height:14px;"></i> View
                                    </a>
                                    <a href="/Faculty/Edit/@f.Id" class="btn btn-sm btn-outline-warning" title="Edit">
                                        <i class="align-middle" data-feather="edit" style="width:14px;height:14px;"></i>
                                    </a>
                                    <a href="/Faculty/Delete/@f.Id" class="btn btn-sm btn-outline-danger" title="Delete">
                                        <i class="align-middle" data-feather="trash-2" style="width:14px;height:14px;"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            
            @if (Model.TotalPages > 1)
            {
                <div class="card-footer pb-0 pt-3">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link" href="?page=@(Model.PageNumber - 1)&search=@Model.SearchQuery">Previous</a>
                        </li>
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                <a class="page-link" href="?page=@i&search=@Model.SearchQuery">@i</a>
                            </li>
                        }
                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-link" href="?page=@(Model.PageNumber + 1)&search=@Model.SearchQuery">Next</a>
                        </li>
                    </ul>
                </div>
            }
        }
    </div>
</div>
