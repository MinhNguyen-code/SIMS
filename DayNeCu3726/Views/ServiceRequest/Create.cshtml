@{
    ViewData["Title"] = "Create Service Request";
}

<div class="row mb-3">
    <div class="col-12">
        <h1 class="h3 mb-0 text-gray-800">Submit a Service Request</h1>
        <p class="text-muted">Fill out the form below to submit your request to the student affairs office.</p>
    </div>
</div>

<div class="row">
    <div class="col-md-8 col-xl-6">
        <div class="card shadow-sm border-0 rounded-lg">
            <div class="card-body p-4">
                <form action="/ServiceRequest/Create" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Request Type</label>
                        <select name="RequestType" class="form-select" required>
                            <option value="">-- Select Type --</option>
                            <option value="Certificate">Certificate / Transcript</option>
                            <option value="Leave">Absence / Leave</option>
                            <option value="Fee">Tuition / Fee Query</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Title</label>
                        <input type="text" name="Title" class="form-control" placeholder="E.g., Request for official transcript" required />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">Description</label>
                        <textarea name="Description" class="form-control" rows="5" placeholder="Provide detailed information about your request..." required></textarea>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a href="/ServiceRequest" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary shadow-sm">Submit Request</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-xl-6 d-none d-md-block">
        <div class="card bg-light border-0">
            <div class="card-body">
                <h5 class="card-title fw-bold">Guidelines</h5>
                <ul class="text-muted small ps-3 mb-0">
                    <li class="mb-2">Ensure you select the correct request type to avoid delays.</li>
                    <li class="mb-2">Provide clear and concise details in the description.</li>
                    <li class="mb-2">Most requests are processed within 2-3 business days.</li>
                    <li>You can track the status of your request on the Service Requests dashboard.</li>
                </ul>
            </div>
        </div>
    </div>
</div>
