@model IEnumerable<DayNeCu3726.Models.ViewModels.ServiceRequestViewModel>

@{
    ViewData["Title"] = "Manage Service Requests";
}

<h1 class="h3 mb-3">Manage Student Requests</h1>

<div class="card">
    <div class="card-header">
        <ul class="nav nav-tabs card-header-tabs" id="request-tabs" role="tablist">
            <li class="nav-item">
                <a class="nav-link active" id="all-tab" data-bs-toggle="tab" href="#all" role="tab">All</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="pending-tab" data-bs-toggle="tab" href="#pending" role="tab">Pending</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="approved-tab" data-bs-toggle="tab" href="#approved" role="tab">Approved</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="rejected-tab" data-bs-toggle="tab" href="#rejected" role="tab">Rejected</a>
            </li>
        </ul>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover table-striped">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Request Type</th>
                        <th>Student</th>
                        <th>Created At</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Title</td>
                            <td>@item.TypeName</td>
                            <td>@item.StudentName</td>
                            <td>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="status-cell" data-status="@item.Status">
                                <span class="badge @item.StatusBadgeClass">@item.StatusText</span>
                            </td>
                            <td>
                                @if (item.Status == DayNeCu3726.Models.Enums.RequestStatus.Pending || item.Status == DayNeCu3726.Models.Enums.RequestStatus.InReview)
                                {
                                    <button class="btn btn-sm btn-success" onclick="openProcessModal('@item.RequestId', 'Approved')">Approve</button>
                                    <button class="btn btn-sm btn-danger" onclick="openProcessModal('@item.RequestId', 'Rejected')">Reject</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal for Admin Note -->
<div class="modal fade" id="processRequestModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="processRequestForm" method="post" action="@Url.Action("Process", "ServiceRequest")">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Process Request</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="requestId" name="id" value="" />
                    <input type="hidden" id="requestStatus" name="status" value="" />
                    
                    <div class="mb-3">
                        <label class="form-label">Admin Response</label>
                        <textarea class="form-control" name="adminResponse" rows="3" placeholder="Enter reason or response for the student..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Confirm</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openProcessModal(id, status) {
            document.getElementById('requestId').value = id;
            document.getElementById('requestStatus').value = status;
            var modal = new bootstrap.Modal(document.getElementById('processRequestModal'));
            modal.show();
        }

        document.querySelectorAll('#request-tabs .nav-link').forEach(tab => {
            tab.addEventListener('click', function(e) {
                e.preventDefault();
                document.querySelectorAll('#request-tabs .nav-link').forEach(t => t.classList.remove('active'));
                this.classList.add('active');

                var filter = this.getAttribute('id').replace('-tab', '');
                document.querySelectorAll('tbody tr').forEach(row => {
                    var status = row.querySelector('.status-cell').getAttribute('data-status');
                    if (filter === 'all') {
                        row.style.display = '';
                    } else if (filter === 'pending') {
                        if (status === 'Pending' || status === 'InReview') row.style.display = '';
                        else row.style.display = 'none';
                    } else if (filter === 'approved' && status === 'Approved') {
                        row.style.display = '';
                    } else if (filter === 'rejected' && status === 'Rejected') {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });
            });
        });
    </script>
}
