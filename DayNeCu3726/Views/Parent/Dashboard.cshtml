@{
    ViewData["Title"] = "Parent Dashboard";
}

<div class="row mb-4">
    <div class="col-12">
        <h1 class="h3 mb-0 text-gray-800">Parent Dashboard</h1>
        <p class="text-muted">Welcome to the Parent Portal. Here is an overview of your child's academic progress.</p>
    </div>
</div>

<div class="row">
    <!-- Student Profile Card -->
    <div class="col-md-12 mb-4">
        <div class="card shadow-sm border-0 bg-white">
            <div class="card-body d-flex align-items-center p-4">
                <div class="avatar-initials bg-primary text-white fs-3 rounded-circle d-flex justify-content-center align-items-center me-4" style="width: 80px; height: 80px;">
                    MN
                </div>
                <div>
                    <h4 class="fw-bold mb-1">Nguyen Minh Nhat</h4>
                    <p class="text-muted mb-2">Student ID: SE123456 &bull; Major: Software Engineering</p>
                    <span class="badge bg-success px-3 py-2">Status: Enrolled</span>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- GPA Widget -->
    <div class="col-xl-4 col-md-6 mb-4">
        <div class="card shadow-sm border-0 h-100 border-start border-4 border-primary">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-xs fw-bold text-primary text-uppercase mb-1">Current GPA</div>
                        <div class="h3 mb-0 fw-bold text-gray-800">3.8 / 4.0</div>
                    </div>
                    <div class="stat text-primary bg-light rounded p-3">
                        <i class="align-middle" data-feather="award"></i>
                    </div>
                </div>
                <div class="mt-3 text-muted small">Top 10% of class</div>
            </div>
        </div>
    </div>

    <!-- Attendance Widget -->
    <div class="col-xl-4 col-md-6 mb-4">
        <div class="card shadow-sm border-0 h-100 border-start border-4 border-warning">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-xs fw-bold text-warning text-uppercase mb-1">Attendance Warnings</div>
                        <div class="h3 mb-0 fw-bold text-gray-800">1</div>
                    </div>
                    <div class="stat text-warning bg-light rounded p-3">
                        <i class="align-middle" data-feather="alert-triangle"></i>
                    </div>
                </div>
                <div class="mt-3 text-muted small"><a href="/Parent/Attendance" class="text-warning text-decoration-none">View details &rarr;</a></div>
            </div>
        </div>
    </div>

    <!-- Tuition Widget -->
    <div class="col-xl-4 col-md-12 mb-4">
        <div class="card shadow-sm border-0 h-100 border-start border-4 border-danger">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-xs fw-bold text-danger text-uppercase mb-1">Unpaid Tuition</div>
                        <div class="h3 mb-0 fw-bold text-gray-800">9,000,000 VND</div>
                    </div>
                    <div class="stat text-danger bg-light rounded p-3">
                        <i class="align-middle" data-feather="dollar-sign"></i>
                    </div>
                </div>
                <div class="mt-3 text-muted small"><a href="/Parent/Finance" class="text-danger text-decoration-none">Pay now &rarr;</a></div>
            </div>
        </div>
    </div>
</div>

<div class="row mt-2">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white pb-0">
                <h5 class="fw-bold mb-0">Quick Links</h5>
            </div>
            <div class="card-body">
                <div class="list-group list-group-flush">
                    <a href="/Parent/Grades" class="list-group-item list-group-item-action d-flex align-items-center py-3">
                        <i class="align-middle text-primary me-3" data-feather="file-text"></i>
                        View Detailed Transcript
                    </a>
                    <a href="/Parent/Attendance" class="list-group-item list-group-item-action d-flex align-items-center py-3">
                        <i class="align-middle text-warning me-3" data-feather="calendar"></i>
                        Check Attendance Records
                    </a>
                    <a href="/Parent/Finance" class="list-group-item list-group-item-action d-flex align-items-center py-3">
                        <i class="align-middle text-success me-3" data-feather="credit-card"></i>
                        Manage Tuition Payments
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
