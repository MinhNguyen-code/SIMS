@{
    ViewData["Title"] = "Child's Attendance";
}

<div class="row mb-3">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <div>
            <h1 class="h3 mb-0 text-gray-800">Attendance Report</h1>
            <p class="text-muted mb-0">Student: Nguyen Minh Nhat (SE123456)</p>
        </div>
        <a href="/Parent/Dashboard" class="btn btn-outline-secondary btn-sm">
            <i class="align-middle me-1" data-feather="arrow-left"></i> Back to Dashboard
        </a>
    </div>
</div>

<div class="card shadow-sm border-0 rounded-lg">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Course</th>
                        <th class="text-center">Total Sessions</th>
                        <th class="text-center">Attended</th>
                        <th class="text-center">Absent</th>
                        <th class="text-center">Absence %</th>
                        <th class="text-center pe-4">Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="ps-4 fw-bold">Advanced Programming (C#)</td>
                        <td class="text-center">30</td>
                        <td class="text-center text-success">28</td>
                        <td class="text-center text-danger">2</td>
                        <td class="text-center">6.6%</td>
                        <td class="text-center pe-4"><span class="badge bg-success">Good</span></td>
                    </tr>
                    <tr>
                        <td class="ps-4 fw-bold">Database Systems</td>
                        <td class="text-center">30</td>
                        <td class="text-center text-success">24</td>
                        <td class="text-center text-danger">6</td>
                        <td class="text-center text-warning fw-bold">20.0%</td>
                        <td class="text-center pe-4"><span class="badge bg-warning text-dark">Warning</span></td>
                    </tr>
                    <tr>
                        <td class="ps-4 fw-bold">Web Development</td>
                        <td class="text-center">30</td>
                        <td class="text-center text-success">29</td>
                        <td class="text-center text-danger">1</td>
                        <td class="text-center">3.3%</td>
                        <td class="text-center pe-4"><span class="badge bg-success">Good</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
<div class="mt-3 text-muted small">
    * Note: Absence rate exceeding 20% will result in exam ban.
</div>
