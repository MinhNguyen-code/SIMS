@{
    ViewData["Title"] = "Submit Assignment";
    var assignment = ViewBag.Assignment as DayNeCu3726.Models.Entities.Assignment;
}

<div class="mb-3">
    <a href="/Assignment/Index" class="text-decoration-none"><i data-feather="arrow-left"></i> Back to Assignments</a>
</div>

<h1 class="h3 mb-3">Submit Assignment</h1>

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">@assignment?.Title</h5>
        <h6 class="card-subtitle text-muted mb-3">Course: @assignment?.Course?.Name</h6>
        <p class="card-text" style="white-space: pre-wrap;">@assignment?.Description</p>
        <p class="card-text text-danger"><strong>Deadline:</strong> @assignment?.Deadline.ToLocalTime().ToString("g")</p>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h5 class="card-title mb-0">Upload PDF</h5>
    </div>
    <div class="card-body">
        <form method="post" action="/Assignment/Submit/@assignment?.AssignmentId" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label">Select PDF file</label>
                <input type="file" name="file" class="form-control" accept="application/pdf" required />
                <div class="form-text">Only .pdf files are allowed.</div>
            </div>
            <button type="submit" class="btn btn-primary">Submit</button>
        </form>
    </div>
</div>
