@model DayNeCu3726.Models.ViewModels.CourseViewModel
@{
    ViewData["Title"] = "Add Course";
    var faculties = ViewBag.Faculties as IEnumerable<dynamic> ?? new List<dynamic>();
}

<div class="page-header">
    <div>
        <h1 class="page-title"><i data-feather="plus" class="sims-h-ico"></i> New Course</h1>
        <p class="page-subtitle">Create a new course offering</p>
    </div>
    <a href="/Course" class="btn btn-secondary"><i data-feather="arrow-left" class="sims-h-ico"></i> Back</a>
</div>

<div class="card" style="max-width:800px;">
    <div class="card-header"><span class="card-title"><i data-feather="book-open" class="sims-h-ico"></i> Course Information</span></div>
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="form-grid-2">
                <div class="form-group">
                    <label class="form-label">Course Code *</label>
                    <input asp-for="CourseCode" class="form-control" placeholder="e.g., CS101" />
                    <span asp-validation-for="CourseCode" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label class="form-label">Credits *</label>
                    <input asp-for="Credits" type="number" class="form-control" min="1" max="10" />
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Course Name *</label>
                <input asp-for="Name" class="form-control" placeholder="Introduction to Programming" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label class="form-label">Description</label>
                <textarea asp-for="Description" class="form-control" rows="3"
                          placeholder="Course overview, objectives…"></textarea>
            </div>

            <div class="form-grid-2">
                <div class="form-group">
                    <label class="form-label">Assigned Faculty</label>
                    <select asp-for="FacultyId" class="form-control">
                        <option value="">— Select Faculty —</option>
                        @foreach (var f in faculties)
                        {
                            <option value="@f.Id">@f.FullName</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Max Enrollment</label>
                    <input asp-for="MaxEnrollment" type="number" class="form-control" min="1" max="500" />
                </div>
            </div>

            <div class="form-grid-2">
                <div class="form-group">
                    <label class="form-label">Schedule</label>
                    <input asp-for="Schedule" class="form-control" placeholder="Mon/Wed 09:00–10:30" />
                </div>
                <div class="form-group">
                    <label class="form-label">Classroom</label>
                    <input asp-for="Classroom" class="form-control" placeholder="A101" />
                </div>
            </div>

            <div class="form-grid-2">
                <div class="form-group">
                    <label class="form-label">Semester</label>
                    <input asp-for="Semester" class="form-control" placeholder="2024-2" />
                </div>
                <div class="form-group">
                    <label class="form-label">Status</label>
                    <select asp-for="Status" class="form-control">
                        @foreach (var s in Enum.GetValues<DayNeCu3726.Models.Enums.CourseStatus>())
                        {
                            <option value="@((int)s)">@s</option>
                        }
                    </select>
                </div>
            </div>

            <div class="d-flex gap-12" style="margin-top:8px;">
                <button type="submit" class="btn btn-primary btn-lg"><i data-feather="check-circle" class="sims-h-ico"></i> Create Course</button>
                <a href="/Course" class="btn btn-secondary btn-lg">Cancel</a>
            </div>
        </form>
    </div>
</div>
