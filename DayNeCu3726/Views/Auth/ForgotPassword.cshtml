@model DayNeCu3726.Models.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="sims-auth">
    <section class="sims-auth__brand">
        <div class="sims-auth__logo">
            <span class="sims-auth__logo-mark" aria-hidden="true">S</span>
            <span>
                <span class="sims-auth__logo-text d-block">SIMS</span>
                <span class="sims-auth__logo-sub">Student Information</span>
            </span>
        </div>
        <div>
            <h1 class="sims-auth__headline">Account Recovery</h1>
            <p class="sims-auth__lede">
                Verify your identity using your assigned Recovery PIN to regain access to your account.
            </p>
        </div>
    </section>

    <section class="sims-auth__panel">
        <div class="sims-auth__form">
            <h2 class="sims-auth__title">Forgot Password?</h2>
            <p class="sims-auth__subtitle">Enter your email and Recovery PIN to reset your password.</p>

            <form asp-action="ForgotPassword" method="post" id="forgotPwdForm" novalidate>
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email address</label>
                    <input asp-for="Email" class="form-control form-control-lg" type="email"
                           placeholder="you@sims.edu" autocomplete="email" autofocus />
                    <span asp-validation-for="Email" class="text-danger" style="font-size:12px;"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="RecoveryPin" class="form-label">Recovery PIN</label>
                    <input asp-for="RecoveryPin" class="form-control form-control-lg" type="text"
                           placeholder="Enter 6-digit PIN" autocomplete="off" />
                    <span asp-validation-for="RecoveryPin" class="text-danger" style="font-size:12px;"></span>
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100" id="verifyBtn">
                    <span id="verifyBtnText">Verify & Continue</span>
                    <i data-feather="arrow-right" style="width:16px;height:16px;"></i>
                </button>

                <div class="mt-3 text-center">
                    <a asp-action="Login" class="text-decoration-none text-muted" style="font-size:13px;">&larr; Back to sign in</a>
                </div>
            </form>
            
            <div class="sims-demo mt-4">
                <div class="sims-demo__head">Demo Information</div>
                <p class="text-center text-muted mb-0" style="font-size:11.5px;">
                    In this demo version, all default accounts use the Recovery PIN: <strong>123456</strong>
                </p>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var form = document.getElementById('forgotPwdForm');
            if (!form) return;
            form.addEventListener('submit', function () {
                var btn = document.getElementById('verifyBtn');
                var txt = document.getElementById('verifyBtnText');
                if (btn && txt) { btn.disabled = true; txt.textContent = 'Verifying…'; }
            });
        })();
    </script>
}
