@{
    ViewData["Title"] = "Teacher Feedback";
}

<div class="row mb-3">
    <div class="col-12">
        <h1 class="h3 mb-0 text-gray-800">Teacher Evaluation</h1>
        <p class="text-muted">Please provide constructive feedback for your courses. Your responses are anonymous.</p>
    </div>
</div>

<div class="row">
    <!-- Course 1 -->
    <div class="col-md-6 mb-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <h5 class="card-title fw-bold mb-1">Advanced Programming (C#)</h5>
                        <p class="text-muted small mb-0">Instructor: Dr. Nguyen Van A</p>
                    </div>
                    <span class="badge bg-success">Evaluated</span>
                </div>
                <p class="small text-muted mb-4">Feedback submitted on Oct 20, 2023.</p>
                <button class="btn btn-outline-secondary btn-sm w-100" disabled>Completed</button>
            </div>
        </div>
    </div>

    <!-- Course 2 -->
    <div class="col-md-6 mb-4">
        <div class="card shadow-sm border-0 h-100 border-start border-4 border-warning">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <h5 class="card-title fw-bold mb-1">Database Systems</h5>
                        <p class="text-muted small mb-0">Instructor: Prof. Tran Thi B</p>
                    </div>
                    <span class="badge bg-warning text-dark">Not evaluated</span>
                </div>
                <p class="small text-muted mb-4">Evaluation period closes on Nov 15, 2023.</p>
                <a href="/Feedback/Create" class="btn btn-primary btn-sm w-100 shadow-sm">Start Evaluation</a>
            </div>
        </div>
    </div>
</div>
